{
  "manifest_version": 3,
  "name": "Cinebox Player Guard",
  "version": "1.2.0",
  "description": "Blocks popup and redirect ads opened by Cinebox video player frames. Works without configuration.",
  "minimum_chrome_version": "101",
  "key": "",
  "permissions": [
    "storage",
    "webNavigation",
    "declarativeNetRequest"
  ],
  "background": {
    "service_worker": "service-worker.mjs",
    "type": "module"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "guard.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
