# Login Cinebox. Salin ke .env.local (lokal) atau isi di pengaturan environment hosting.
# Tanpa ketiga nilai ini, tidak ada yang bisa login (situs tertutup sepenuhnya).
CINEBOX_USERNAME=admin
CINEBOX_PASSWORD=ganti-dengan-kata-sandi-yang-kuat
# Minimal 32 karakter acak. Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CINEBOX_AUTH_SECRET=
